{
  "mcpServers": {
    "matlab": {
      "command": "python",
      "args": ["scripts/start_matlab_mcp.py"],
      "transport": "stdio",
      "lifecycle": "lazy",
      "requestTimeoutMs": 120000
    },
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"],
      "transport": "stdio",
      "lifecycle": "eager",
      "requestTimeoutMs": 60000
    }
  }
}
